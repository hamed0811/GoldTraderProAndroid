# GoldMind AI — Environment Configuration
# Copy to .env locally. NEVER commit real API keys.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
FALLBACK_MODEL=gpt-5

# Telegram signal-only bot. Keep the real token local; never commit it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SEND_WAIT=false
TELEGRAM_POLL_SECONDS=2
