# Copy to .env on the Oracle VM. The installer generates the random API tokens.
GOLDTRADER_INGEST_TOKEN=replace_with_random_64_character_secret
GOLDTRADER_READ_TOKEN=replace_with_a_different_random_64_character_secret
CLOUDFLARE_TUNNEL_TOKEN=
GOLDTRADER_DATA_DIR=/data
GOLDTRADER_MAX_QUOTE_AGE_SECONDS=15
LOG_LEVEL=INFO
